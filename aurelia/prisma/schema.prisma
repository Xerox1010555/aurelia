// Prisma schema scaffolded at M0 per the master blueprint.
// Activate at M5: `npm i -D prisma && npm i @prisma/client && npx prisma generate`
// then set DATABASE_URL in .env and run `npx prisma migrate dev`.
// Not imported anywhere in the M0–M3 codebase — the build stays DB-free.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CONCIERGE
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  name            String
  phone           String?
  locale          String   @default("en")
  currency        String   @default("USD")
  role            Role     @default(CUSTOMER)
  marketingOptIn  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  refreshTokens   RefreshToken[]
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  appointments    Appointment[]
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  countryCode String
  phone       String
  isDefault   Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Boutique {
  id      String  @id @default(cuid())
  code    String  @unique
  cityEn  String
  cityAr  String
  address String
  hours   String
  phone   String?
  lat     Float?
  lng     Float?
  active  Boolean @default(true)
  sort    Int     @default(0)
}

enum BezelType {
  DIVE
  TACHY
  GMT
  FLUTED
}

model CatalogModel {
  id             String     @id @default(cuid())
  slug           String     @unique
  nameEn         String
  nameAr         String
  taglineEn      String
  taglineAr      String
  refNumber      String
  basePriceCents Int
  bezelType      BezelType
  defaultDial    String
  defaultMetal   String
  defaultBracelet String
  attrs          Json
  published      Boolean    @default(true)
  sort           Int        @default(0)
  configurations Configuration[]
  inventories    Inventory[]
  reviews        Review[]
}

enum OptionGroup {
  METAL
  DIAL
  BEZEL
  BRACELET
}

model Option {
  id              String      @id @default(cuid())
  group           OptionGroup
  key             String
  nameEn          String
  nameAr          String
  priceDeltaCents Int         @default(0)
  attrs           Json?
  sort            Int         @default(0)
  modelOptions    ModelOption[]
}

model ModelOption {
  modelId  String
  optionId String
  model    CatalogModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  option   Option       @relation(fields: [optionId], references: [id], onDelete: Cascade)
  @@id([modelId, optionId])
}

model Configuration {
  id          String @id @default(cuid())
  fingerprint String @unique
  modelId     String
  metalId     String?
  dialId      String
  bezelId     String
  braceletId  String
  priceCents  Int
  model       CatalogModel @relation(fields: [modelId], references: [id])
  cartItems   CartItem[]
  waitlists   Waitlist[]
}

model Inventory {
  id           String       @id @default(cuid())
  modelId      String
  qtyAvailable Int          @default(0)
  qtyReserved  Int          @default(0)
  trackable    Boolean      @default(true)
  model        CatalogModel @relation(fields: [modelId], references: [id])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  anonToken String?  @unique
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  items     CartItem[]
  @@index([anonToken])
}

model CartItem {
  id             String @id @default(cuid())
  cartId         String
  configurationId String
  qty            Int
  unitPriceCents Int
  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  configuration  Configuration @relation(fields: [configurationId], references: [id])
  @@index([cartId])
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  IN_ATELIER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  email           String
  phone           String
  locale          String
  currency        String
  subtotalCents   Int
  totalCents      Int
  status          OrderStatus @default(DRAFT)
  paymentIntentId String?
  shippingData    Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  events          OrderEvent[]
  payments        Payment[]
  @@index([status, createdAt])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  modelId              String
  configurationSnapshot Json
  qty                  Int
  unitPriceCents       Int
  lineTotalCents       Int
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  provider    String
  providerRef String
  amountCents Int
  currency    String
  status      String
  raw         Json?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  @@index([orderId])
}

model Waitlist {
  id          String @id @default(cuid())
  email       String
  modelId     String
  fingerprint String?
  createdAt   DateTime @default(now())
  model       CatalogModel @relation(fields: [modelId], references: [id])
  @@unique([email, modelId])
}

model Newsletter {
  id          String    @id @default(cuid())
  email       String    @unique
  locale      String    @default("en")
  status      String    @default("PENDING")
  token       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

enum AppointmentService {
  VIEWING
  SERVICE
  ATELIER
  VALUATION
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Appointment {
  id         String            @id @default(cuid())
  boutiqueId String
  userId     String?
  name       String
  email      String
  phone      String
  service    AppointmentService
  slotAt     DateTime
  status     AppointmentStatus @default(REQUESTED)
  notes      String?
  tz         String            @default("UTC")
  createdAt  DateTime          @default(now())
  boutique   Boutique          @relation(fields: [boutiqueId], references: [id])
  user       User?             @relation(fields: [userId], references: [id])
  @@index([boutiqueId, slotAt])
}

model Review {
  id         String       @id @default(cuid())
  modelId    String
  authorName String
  city       String
  rating     Int
  quote      String
  approved   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  model      CatalogModel @relation(fields: [modelId], references: [id])
}

model CurrencyRate {
  code      String   @id
  symbol    String
  rate      Decimal  @db.Decimal(12, 6)
  fetchedAt DateTime
}
